// RoadRunner - Traffic & Fleet Management System
// Complete merged Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// FLEET & DRIVER MANAGEMENT
// ============================================================

model Vehicle {
  id              Int           @id @default(autoincrement())
  registrationNo  String        @unique @db.VarChar(20)
  vin             String?       @unique @db.VarChar(40)
  make            String        @db.VarChar(60)
  model           String        @db.VarChar(60)
  manufactureYear Int?
  vehicleType     String        @db.VarChar(40)
  capacity        Decimal       @db.Decimal(10, 2)
  fuelType        FuelType
  status          VehicleStatus @default(AVAILABLE)
  odometerKm      Decimal       @default(0) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trips       Trip[]
  fuelLogs    FuelLog[]
  maintenance Maintenance[]
  predictions TripDelayPrediction[]

  @@index([status])
  @@index([vehicleType, status])
  @@map("vehicles")
}

model Driver {
  id            Int          @id @default(autoincrement())
  firstName     String       @db.VarChar(60)
  lastName      String       @db.VarChar(60)
  phone         String       @unique @db.VarChar(25)
  email         String?      @unique @db.VarChar(254)
  licenceNumber String       @unique @db.VarChar(50)
  licenceExpiry DateTime     @db.Date
  status        DriverStatus @default(AVAILABLE)
  hiredAt       DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  trips Trip[]

  @@index([status])
  @@index([licenceExpiry])
  @@map("drivers")
}

model FuelLog {
  id             Int      @id @default(autoincrement())
  vehicleId      Int
  tripId         Int?
  refuelledAt    DateTime @default(now())
  quantityLitres Decimal  @db.Decimal(10, 2)
  cost           Decimal  @db.Decimal(10, 2)
  odometerKm     Decimal? @db.Decimal(12, 2)
  station        String?  @db.VarChar(120)
  notes          String?  @db.VarChar(500)
  createdAt      DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([vehicleId, refuelledAt])
  @@index([refuelledAt])
  @@index([tripId])
  @@map("fuel_logs")
}

model Maintenance {
  id              Int               @id @default(autoincrement())
  vehicleId       Int
  serviceDate     DateTime          @default(now())
  maintenanceType MaintenanceType   @default(ROUTINE)
  description     String            @db.VarChar(500)
  cost            Decimal           @default(0) @db.Decimal(10, 2)
  odometerKm      Decimal?          @db.Decimal(12, 2)
  nextServiceDate DateTime?         @db.Date
  status          MaintenanceStatus @default(COMPLETED)
  provider        String?           @db.VarChar(120)
  technician      String?           @db.VarChar(120)
  notes           String?           @db.VarChar(500)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([vehicleId, serviceDate])
  @@index([status, nextServiceDate])
  @@map("maintenance_records")
}

// ============================================================
// ROUTES, TRIPS & TRAFFIC INCIDENTS
// ============================================================

model Route {
  id               Int         @id @default(autoincrement())
  name             String      @db.VarChar(100)
  source           String      @db.VarChar(100)
  destination      String      @db.VarChar(100)
  distanceKm       Float       @map("distance_km")
  expectedDuration Int         @map("expected_duration")
  description      String?     @db.Text
  status           RouteStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  trips       Trip[]
  incidents   TrafficIncident[]
  predictions TripDelayPrediction[]

  @@index([status])
  @@map("routes")
}

model Trip {
  id               Int        @id @default(autoincrement())
  routeId          Int        @map("route_id")
  vehicleId        Int        @map("vehicle_id")
  driverId         Int        @map("driver_id")
  scheduledAt      DateTime   @map("scheduled_at")
  departedAt       DateTime?  @map("departed_at")
  arrivedAt        DateTime?  @map("arrived_at")
  status           TripStatus @default(SCHEDULED)
  actualDistanceKm Float?     @map("actual_distance_km")
  delayMinutes     Int?       @map("delay_minutes")
  passengerCount   Int?       @map("passenger_count")
  cargoWeightKg    Float?     @map("cargo_weight_kg")
  notes            String?    @db.Text
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  route   Route   @relation(fields: [routeId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  fuelLogs    FuelLog[]
  predictions TripDelayPrediction[]

  @@index([status])
  @@index([scheduledAt])
  @@index([vehicleId])
  @@index([driverId])
  @@index([routeId])
  @@map("trips")
}

model TrafficIncident {
  id             Int              @id @default(autoincrement())
  routeId        Int              @map("route_id")
  incidentType   IncidentType     @map("incident_type")
  severity       IncidentSeverity
  location       String           @db.VarChar(255)
  description    String?          @db.Text
  reportedAt     DateTime         @map("reported_at")
  resolvedAt     DateTime?        @map("resolved_at")
  estimatedDelay Int?             @map("estimated_delay")
  status         IncidentStatus   @default(ACTIVE)
  reportedBy     String?          @map("reported_by") @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  route Route @relation(fields: [routeId], references: [id])

  @@index([routeId])
  @@index([status])
  @@index([severity])
  @@index([reportedAt])
  @@map("traffic_incidents")
}

// ============================================================
// AI/ML - TRIP DELAY PREDICTIONS
// ============================================================

model TripDelayPrediction {
  id                 Int      @id @default(autoincrement())
  tripId             Int?     @map("trip_id")
  routeId            Int      @map("route_id")
  vehicleId          Int?     @map("vehicle_id")
  routeDistance      Float    @map("route_distance")
  departureHour      Int      @map("departure_hour")
  dayOfWeek          Int      @map("day_of_week")
  historicalAvgDelay Float    @map("historical_avg_delay")
  activeIncidents    Int      @map("active_incidents")
  predictedDelay     Float    @map("predicted_delay")
  modelVersion       String   @default("v1") @map("model_version") @db.VarChar(20)
  confidence         Float?
  createdAt          DateTime @default(now()) @map("created_at")

  trip    Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  route   Route    @relation(fields: [routeId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([routeId])
  @@index([vehicleId])
  @@index([tripId])
  @@index([createdAt])
  @@map("trip_delay_predictions")
}

// ============================================================
// ENUMS
// ============================================================

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
  INACTIVE
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  ON_LEAVE
  SUSPENDED
  RETIRED
  INACTIVE
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
  EMERGENCY
  UPGRADE
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

enum IncidentType {
  ACCIDENT
  CONGESTION
  ROAD_CLOSURE
  WEATHER
  CONSTRUCTION
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
  MONITORING
}
